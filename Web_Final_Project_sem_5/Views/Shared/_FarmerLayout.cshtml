@{
    var pageTitle = ViewData["Title"] ?? "Farmer Dashboard";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - CropCare</title>

    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <style>
        body {
            background: #f5f8f4;
            font-family: Arial, sans-serif;
            margin: 0;
        }

        .sidebar {
            width: 250px;
            min-height: 100vh;
            background: #173f2b;
            color: white;
            position: fixed;
            top: 0;
            left: 0;
            padding: 25px 18px;
            z-index: 1000;
        }

        .brand {
            font-family: 'Great Vibes', cursive;
            font-size: 38px;
            font-weight: normal;
            margin-bottom: 20px;
        }

        .sidebar a {
            display: block;
            color: #dce9df;
            text-decoration: none;
            padding: 12px 14px;
            border-radius: 8px;
            margin-bottom: 7px;
            transition: 0.2s;
        }

            .sidebar a:hover,
            .sidebar a.active {
                background: #2f6845;
                color: white;
            }

        .main-content {
            margin-left: 250px;
            padding: 30px;
            min-height: 100vh;
        }

        .topbar {
            background: white;
            padding: 17px 22px;
            border-radius: 12px;
            margin-bottom: 28px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        .stat-card {
            background: white;
            border: none;
            border-radius: 13px;
            padding: 22px;
            height: 100%;
            box-shadow: 0 3px 12px rgba(0,0,0,0.04);
        }

        .stat-icon {
            width: 45px;
            height: 45px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 21px;
        }

        .content-card {
            background: white;
            border: none;
            border-radius: 13px;
            padding: 22px;
            height: 100%;
            box-shadow: 0 3px 12px rgba(0,0,0,0.04);
        }

        @@media (max-width: 768px) {
            .sidebar {
                width: 75px;
                padding: 20px 10px;
            }

                .sidebar .brand-text,
                .sidebar .menu-text,
                .sidebar .menu-heading {
                    display: none;
                }

                .sidebar a {
                    text-align: center;
                    font-size: 20px;
                }

                    .sidebar a i {
                        margin: 0 !important;
                    }

            .main-content {
                margin-left: 75px;
                padding: 15px;
            }
        }
    </style>
</head>

<body>

    <aside class="sidebar">

        <div class="brand">
            <i class="bi bi-flower1"></i>
            <span class="brand-text"
                  style="font-family: 'Great Vibes', cursive;">
                CropCare
            </span>
        </div>

        <small class="text-uppercase text-white-50 px-3 menu-heading">
            Main Menu
        </small>

        <a asp-controller="Farmer"
           asp-action="Dashboard"
           class="@(currentAction == "Dashboard" ? "active" : "")">

            <i class="bi bi-grid me-2"></i>
            <span class="menu-text">Dashboard</span>
        </a>

        <a asp-controller="Farmer"
           asp-action="MyFarms"
           class="@(currentAction == "MyFarms" ? "active" : "")">

            <i class="bi bi-tree me-2"></i>
            <span class="menu-text">My Farms</span>
        </a>

        <a asp-controller="Farmer"
           asp-action="MyCrops"
           class="@(currentAction == "MyCrops" ? "active" : "")">

            <i class="bi bi-flower2 me-2"></i>
            <span class="menu-text">My Crops</span>
        </a>

        <a href="#">
            <i class="bi bi-cloud-sun me-2"></i>
            <span class="menu-text">Weather</span>
        </a>

        <a href="#">
            <i class="bi bi-calendar-check me-2"></i>
            <span class="menu-text">Harvest Planner</span>
        </a>

        <a href="#">
            <i class="bi bi-wallet2 me-2"></i>
            <span class="menu-text">Finance</span>
        </a>

        <hr class="border-light opacity-25" />

        <a href="#">
            <i class="bi bi-person-circle me-2"></i>
            <span class="menu-text">My Profile</span>
        </a>

    </aside>

    <main class="main-content">

        <header class="topbar">

            <div>
                <h5 class="mb-1">Welcome to CropCare</h5>
                <small class="text-muted">
                    Your farm management space
                </small>
            </div>

            <div class="d-flex align-items-center gap-3">

                <span class="text-muted">
                    <i class="bi bi-person-circle me-1"></i>
                    @User.Identity?.Name
                </span>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-outline-danger btn-sm">

                        <i class="bi bi-box-arrow-right me-1"></i>
                        Logout

                    </button>

                </form>

            </div>

        </header>

        @RenderBody()

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
