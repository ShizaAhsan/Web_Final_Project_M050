@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_FarmerLayout.cshtml";
}

<div class="mb-4">
    <h3 class="fw-bold">Dashboard</h3>
    <p class="text-muted">Here's an overview of your farming activities.</p>
</div>

<!-- Statistics -->
<div class="row g-3 mb-4">

    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted mb-2">Total Farms</p>
                    <h3 class="fw-bold mb-0">0</h3>
                </div>
                <div class="stat-icon bg-success-subtle text-success">
                    <i class="bi bi-tree"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted mb-2">Active Crops</p>
                    <h3 class="fw-bold mb-0">0</h3>
                </div>
                <div class="stat-icon bg-primary-subtle text-primary">
                    <i class="bi bi-flower2"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted mb-2">Upcoming Harvests</p>
                    <h3 class="fw-bold mb-0">0</h3>
                </div>
                <div class="stat-icon bg-warning-subtle text-warning">
                    <i class="bi bi-calendar-check"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted mb-2">Total Profit/Loss</p>
                    <h3 class="fw-bold mb-0">Rs. 0</h3>
                </div>
                <div class="stat-icon bg-info-subtle text-info">
                    <i class="bi bi-cash-stack"></i>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Main Dashboard Sections -->
<div class="row g-3">

    <!-- Recent Crops -->
    <div class="col-lg-7">
        <div class="content-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">My Recent Crops</h5>
                <a href="#" class="text-success text-decoration-none">
                    View All
                </a>
            </div>

            <div class="text-center py-5">
                <i class="bi bi-flower1 text-success fs-1"></i>
                <h6 class="mt-3">No crops added yet</h6>
                <p class="text-muted small">
                    Add your first crop to start tracking its progress.
                </p>
                <a href="#" class="btn btn-success btn-sm">
                    <i class="bi bi-plus-lg me-1"></i>
                    Add Crop
                </a>
            </div>
        </div>
    </div>

    <!-- Upcoming Harvests -->
    <div class="col-lg-5">
        <div class="content-card">
            <h5 class="fw-bold mb-3">Upcoming Harvests</h5>

            <div class="text-center py-5">
                <i class="bi bi-calendar2-week text-warning fs-1"></i>
                <h6 class="mt-3">No upcoming harvests</h6>
                <p class="text-muted small">
                    Your upcoming harvest dates will appear here.
                </p>
            </div>
        </div>
    </div>

</div>

<!-- Weather Overview -->
<div class="content-card mt-3">
    <div class="d-flex align-items-center gap-3">
        <div class="stat-icon bg-info-subtle text-info">
            <i class="bi bi-cloud-sun"></i>
        </div>

        <div>
            <h5 class="fw-bold mb-1">Weather Overview</h5>
            <p class="text-muted mb-0">
                Add a farm location to view its local weather information.
            </p>
        </div>
    </div>
</div>
