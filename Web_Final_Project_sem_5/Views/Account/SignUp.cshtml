@model Web_Final_Project_sem_5.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Sign Up - CropCare";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CropCare - Sign Up</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body class="bg-light">

    <div class="container-fluid min-vh-100">
        <div class="row min-vh-100">

            <div class="col-lg-6 d-flex align-items-center justify-content-center p-4">

                <div class="w-100" style="max-width: 370px;">

                    <div class="text-center mb-3">
                        <a href="/Home/Index"
                           class="text-success text-decoration-none fs-2"
                           style="font-family: 'Great Vibes', cursive;">
                            CropCare
                        </a>

                        <h4 class="fw-bold mt-1 mb-1">Create Account</h4>

                        <p class="text-secondary small">
                            Sign up to get started with CropCare
                        </p>
                    </div>

                    <form asp-controller="Account"
                          asp-action="SignUp"
                          method="post">

                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                <div asp-validation-summary="All"></div>
                            </div>
                        }

                        <!-- Role Selection -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Sign Up As</label>

                            <div class="d-flex gap-2">
                                <input type="radio"
                                       class="btn-check"
                                       asp-for="Role"
                                       value="Farmer"
                                       id="farmerRole" />

                                <label for="farmerRole"
                                       class="btn @(Model?.Role == "Farmer" ? "btn-success" : "btn-outline-success") btn-sm px-4">
                                    <i class="bi bi-person-fill me-1"></i>
                                    Farmer
                                </label>

                                <input type="radio"
                                       class="btn-check"
                                       asp-for="Role"
                                       value="Admin"
                                       id="adminRole" />

                                <label for="adminRole"
                                       class="btn @(Model?.Role == "Admin" ? "btn-success" : "btn-outline-success") btn-sm px-4">
                                    <i class="bi bi-shield-check me-1"></i>
                                    Admin
                                </label>
                            </div>

                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>

                        <!-- Full Name -->
                        <div class="mb-3">
                            <label asp-for="FullName"
                                   class="form-label small fw-semibold">
                                Full Name
                            </label>

                            <div class="input-group">
                                <span class="input-group-text bg-white">
                                    <i class="bi bi-person text-success"></i>
                                </span>

                                <input asp-for="FullName"
                                       class="form-control"
                                       placeholder="Enter your full name" />
                            </div>

                            <span asp-validation-for="FullName"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="Email"
                                   class="form-label small fw-semibold">
                                Email Address
                            </label>

                            <div class="input-group">
                                <span class="input-group-text bg-white">
                                    <i class="bi bi-envelope text-success"></i>
                                </span>

                                <input asp-for="Email"
                                       class="form-control"
                                       placeholder="Enter your email" />
                            </div>

                            <span asp-validation-for="Email"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Password -->
                        <div class="mb-3">
                            <label asp-for="Password"
                                   class="form-label small fw-semibold">
                                Password
                            </label>

                            <div class="input-group">
                                <span class="input-group-text bg-white">
                                    <i class="bi bi-lock text-success"></i>
                                </span>

                                <input asp-for="Password"
                                       class="form-control"
                                       placeholder="Create a password" />
                            </div>

                            <span asp-validation-for="Password"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Confirm Password -->
                        <div class="mb-3">
                            <label asp-for="ConfirmPassword"
                                   class="form-label small fw-semibold">
                                Confirm Password
                            </label>

                            <div class="input-group">
                                <span class="input-group-text bg-white">
                                    <i class="bi bi-shield-lock text-success"></i>
                                </span>

                                <input asp-for="ConfirmPassword"
                                       class="form-control"
                                       placeholder="Confirm your password" />
                            </div>

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Submit -->
                        <button type="submit"
                                class="btn btn-success w-100 rounded-pill py-2 mt-2">
                            Sign Up
                            <i class="bi bi-arrow-right ms-2"></i>
                        </button>

                    </form>

                    <div class="text-center mt-3">
                        <p class="small text-secondary mb-2">
                            Already have an account?

                            <a href="/Account/Login"
                               class="text-success fw-bold text-decoration-none">
                                Login
                            </a>
                        </p>

                        <a href="/Home/Index"
                           class="text-secondary text-decoration-none small">
                            <i class="bi bi-arrow-left me-1"></i>
                            Back to Home
                        </a>
                    </div>

                </div>
            </div>

            <!-- Right Side Image -->
            <div class="col-lg-6 d-none d-lg-block p-0">
                <div class="h-100 w-100 overflow-hidden">
                    <img src="/images/SignUp.jpg"
                         class="w-100 h-100 object-fit-cover"
                         alt="Green Agricultural Farm">
                </div>
            </div>

        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
