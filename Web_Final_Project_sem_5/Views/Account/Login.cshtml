@model Web_Final_Project_sem_5.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login - CropCare";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CropCare - Login</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body class="bg-light overflow-hidden">

    <div class="container-fluid vh-100 overflow-hidden">
        <div class="row h-100">

            <div class="col-lg-6 d-none d-lg-block p-0">
                <div class="h-100 w-100 overflow-hidden position-relative">

                    <img src="/images/login.jpg"
                         class="w-100 h-100 object-fit-cover"
                         alt="Green Agricultural Farm">

                </div>
            </div>

            <div class="col-lg-6 d-flex align-items-center justify-content-center p-3">

                <div class="w-100" style="max-width: 370px;">

                    <div class="text-center mb-3">

                        <a href="/Home/Index"
                           class="text-success text-decoration-none fs-2"
                           style="font-family: 'Great Vibes', cursive;">
                            CropCare
                        </a>

                        <h4 class="fw-bold mt-1 mb-1">
                            Welcome Back
                        </h4>

                        <p class="text-secondary small mb-0">
                            Login to your account
                        </p>

                    </div>

                    <form id="loginForm"
                          asp-controller="Account"
                          asp-action="Login"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All"
                             class="text-danger small mb-2">
                        </div>
                        <div id="loginMessage" class="text-danger small mb-2"></div>
                        <div class="mb-3">

                            <div class="d-flex align-items-center justify-content-between">

                                <label class="form-label fw-semibold small mb-2">
                                    Login As
                                </label>

                                <div class="d-flex gap-2 mb-2">

                                    @* <input asp-for="Role" *@
                                    @*        type="radio" *@
                                    @*        class="btn-check" *@
                                    @*        id="farmer" *@
                                    @*        value="Farmer"> *@
                                    <input asp-for="Role"
                                           type="radio"
                                           class="btn-check"
                                           id="farmer"
                                           value="Farmer"
                                           checked="@(Model.Role == "Farmer")">

                                    <label class="btn btn-sm btn-outline-success px-3"
                                           for="farmer">
                                        <i class="bi bi-person-fill me-1"></i>
                                        Farmer
                                    </label>

                                    <input asp-for="Role"
                                           type="radio"
                                           class="btn-check"
                                           id="admin"
                                           value="Admin">

                                    <label class="btn btn-sm btn-outline-success px-3"
                                           for="admin">
                                        <i class="bi bi-shield-lock me-1"></i>
                                        Admin
                                    </label>

                                </div>

                            </div>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label small fw-semibold">
                                Email Address
                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-white">
                                    <i class="bi bi-envelope text-success"></i>
                                </span>

                                <input asp-for="Email"
                                       type="email"
                                       class="form-control"
                                       placeholder="Enter your email">

                            </div>

                            <span asp-validation-for="Email"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Password"
                                   class="form-label small fw-semibold">
                                Password
                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-white">
                                    <i class="bi bi-lock text-success"></i>
                                </span>

                                <input asp-for="Password"
                                       type="password"
                                       class="form-control"
                                       placeholder="Enter your password">

                            </div>

                            <span asp-validation-for="Password"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <div class="form-check">

                                <input asp-for="RememberMe"
                                       class="form-check-input">

                                <label asp-for="RememberMe"
                                       class="form-check-label small text-secondary">
                                    Remember me
                                </label>

                            </div>

                            <a href="/Account/ForgotPassword"
                               class="text-success text-decoration-none small fw-semibold">
                                Forgot Password?
                            </a>

                        </div>

                        <button type="submit"
                                class="btn btn-success w-100 rounded-pill py-2">
                            Login
                            <i class="bi bi-arrow-right ms-2"></i>
                        </button>

                    </form>

                    <div class="text-center mt-3">

                        <p class="small text-secondary mb-2">
                            Don't have an account?

                            <a href="/Account/SignUp"
                               class="text-success fw-bold text-decoration-none">
                                Sign Up
                            </a>
                        </p>

                        <a href="/Home/Index"
                           class="text-secondary text-decoration-none small">
                            <i class="bi bi-arrow-left me-1"></i>
                            Back to Home
                        </a>

                    </div>

                </div>

            </div>

        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script>
        $(document).ready(function () {

            console.log("1. jQuery loaded");

            $("#loginForm").on("submit", function (e) {

                console.log("2. Form submitted");

                e.preventDefault();

                $("#loginMessage").text("Checking login...");

                $.ajax({
                    url: $(this).attr("action"),
                    type: "POST",
                    data: $(this).serialize(),

                    success: function (response) {

                        console.log("3. Server response:", response);

                        if (response.success) {
                            window.location.href = response.redirectUrl;
                        }
                        else {
                            $("#loginMessage").text(response.message);
                        }
                    },

                    error: function (xhr) {

                        console.log("AJAX ERROR:", xhr.status);
                        console.log(xhr.responseText);

                        $("#loginMessage").text(
                            "Server error: " + xhr.status
                        );
                    }
                });

            });

        });
    </script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
